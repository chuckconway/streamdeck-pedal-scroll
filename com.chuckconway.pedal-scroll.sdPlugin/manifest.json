{
  "Name": "Pedal Scroll",
  "Version": "1.0.0",
  "Author": "Chuck Conway",
  "Description": "Control browser scrolling with Stream Deck Pedal",
  "Category": "Pedal Scroll",
  "CategoryIcon": "imgs/icon",
  "Icon": "imgs/icon",
  "SDKVersion": 2,
  "Software": {
    "MinimumVersion": "6.4"
  },
  "OS": [
    { "Platform": "mac", "MinimumVersion": "10.15" }
  ],
  "Nodejs": {
    "Version": "20",
    "Debug": "enabled"
  },
  "CodePath": "bin/plugin.js",
  "Actions": [
    {
      "Name": "Scroll Up",
      "UUID": "com.chuckconway.pedal-scroll.scroll-up",
      "Tooltip": "Hold to scroll up",
      "Controllers": ["Keypad"],
      "States": [{}]
    },
    {
      "Name": "Cycle Speed",
      "UUID": "com.chuckconway.pedal-scroll.cycle-speed",
      "Tooltip": "Tap to cycle scroll speed",
      "Controllers": ["Keypad"],
      "States": [{}]
    },
    {
      "Name": "Scroll Down",
      "UUID": "com.chuckconway.pedal-scroll.scroll-down",
      "Tooltip": "Hold to scroll down",
      "Controllers": ["Keypad"],
      "States": [{}]
    }
  ]
}
